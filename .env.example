# Скопируйте в .env (для Docker) или задайте в окружении сервера.

# Порт веб-сервера
PORT=3000

# Файл базы данных SQLite (папка создастся сама)
DATABASE_PATH=data/gym.db

# Демо-режим: тестовые аккаунты и смоделированная загрузка зала. На боевом сайте — false.
DEMO_MODE=false

# Первый администратор ресепшена (создаётся при запуске, если админов ещё нет).
# Пароль — не короче 8 символов. Можно оставить пустым и создать админа командой
#   npm run create-admin -- +79001234567 "Имя Фамилия"
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Адрес сайта (для ссылок в соцсетях и возврата после оплаты)
PUBLIC_URL=https://example.ru

# За nginx/HTTPS: доверять заголовкам прокси и ставить Secure-cookie
TRUST_PROXY=true
COOKIE_SECURE=true

# Онлайн-оплата через ЮKassa (без ключей работает демо-оплата без списания денег)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки по 54-ФЗ через «Чеки от ЮKassa»: true/false и код НДС (1 — без НДС)
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
